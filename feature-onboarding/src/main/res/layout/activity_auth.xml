<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/auth_title"
            android:src="@drawable/vitrine_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/auth_title"
            android:textColor="#022358"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/auth_subtitle"
            android:textColor="#23467F"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_auth"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_card_google"
                android:textColor="#022358"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auth_card_google_body"
                android:textColor="#23467F"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_auth"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_card_secure"
                android:textColor="#022358"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auth_card_secure_body"
                android:textColor="#23467F"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/auth_google_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:backgroundTint="#F95C0F"
            android:text="@string/auth_google"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/auth_offline_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_offline"
            android:textColor="#022358" />

        <ProgressBar
            android:id="@+id/auth_progress"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:indeterminate="true"
            android:indeterminateTint="#F95C0F"
            android:visibility="gone" />

        <TextView
            android:id="@+id/auth_preparing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_preparing"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/auth_preparing_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_preparing_sub"
            android:visibility="gone" />

        <TextView
            android:id="@+id/auth_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
