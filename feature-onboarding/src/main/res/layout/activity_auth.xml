<?xml version="1.0" encoding="utf-8"?>
<!--
  D42.33 — refonte visuelle (spec §8-B, dossier 03_authentification) :
  fond Bg, insigne en tuile blanche rayon 26, titre H2 Jakarta, bouton
  Google = pilule blanche 56 avec logo G OFFICIEL (jamais recoloré, §6),
  3 bénéfices réels, repli hors ligne ancré en bas (D42.26 conservé).

  Contrats préservés : IDs et types (Button auth_google_button /
  auth_offline_button, ProgressBar, TextViews) référencés par AuthActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="8dp">

            <!-- Insigne dans une tuile blanche rayon 26 (§9.1). -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_tuile_blanche_26"
                android:contentDescription="@string/auth_title">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/auth_title"
                    android:src="@drawable/vitrine_logo" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:letterSpacing="-0.03"
                android:text="@string/auth_title"
                android:textColor="#022358"
                android:textSize="21sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:text="@string/auth_subtitle"
                android:textColor="#6C7C99"
                android:textSize="14.5sp" />

            <!-- 3 bénéfices réels (produit D19 : hors ligne, export local,
                 SSO Google sans mot de passe). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/auth_benefit_1"
                        android:textColor="#23467F"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/auth_benefit_2"
                        android:textColor="#23467F"
                        android:textSize="14.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="7dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_check" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="@string/auth_benefit_3"
                        android:textColor="#23467F"
                        android:textSize="14.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Barre de progression : visible uniquement pendant la connexion. -->
            <ProgressBar
                android:id="@+id/auth_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#F95C0F"
                android:visibility="gone" />

            <TextView
                android:id="@+id/auth_preparing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/auth_preparing"
                android:textColor="#022358"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/auth_preparing_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="@string/auth_preparing_sub"
                android:textColor="#6C7C99"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <!-- Bouton Google : pilule blanche 56, logo G officiel (§6). -->
            <Button
                android:id="@+id/auth_google_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_bouton_google"
                android:drawableStart="@drawable/ic_google_g"
                android:drawablePadding="10dp"
                android:gravity="center"
                android:minHeight="56dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/auth_google"
                android:textAllCaps="false"
                android:textColor="#022358"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:elevation="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:text="@string/auth_new_here"
                android:textColor="#6C7C99"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Repli hors ligne ancré (D42.26) : déclaré, jamais caché. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/auth_offline_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:text="@string/auth_offline"
            android:textAllCaps="false"
            android:textColor="#022358"
            android:textSize="14.5sp"
            android:fontFamily="@font/inter_semibold" />

        <TextView
            android:id="@+id/auth_offline_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:gravity="center"
            android:text="@string/auth_offline_body"
            android:textColor="#6C7C99"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
