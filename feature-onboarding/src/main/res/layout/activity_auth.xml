<?xml version="1.0" encoding="utf-8"?>
<!--
  D42.12 — ecran de connexion simplifie.

  Avant : logo + titre + sous-titre + 2 cartes de texte (4 phrases) + bouton +
  bouton secondaire + texte + barre de progression + 2 libelles. Le commercant
  devait lire six blocs avant de pouvoir agir. Nielsen #8 (design minimaliste) :
  chaque element retire est un element qu'il n'a pas a comprendre.

  Apres : une promesse, une phrase, un bouton. Le reste n'apparait qu'au besoin
  (progression pendant la connexion, message en cas d'echec).

  D42.26 (FAIL e2e small 540x960, run 42497790522) : le repli « Continuer
  sans compte » etait rendu SOUS le bas de l'ecran (bounds [0,0][0,0] dans le
  dump) — la sortie de secours D19 doit rester visible SANS defiler sur tout
  ecran. Restructuration : contenu principal defilable (ScrollView poids 1) +
  bloc bas ANCRE contenant le repli hors-ligne. Corollaire : sur petit ecran
  le clic de secours ne peut plus se poser sur le bouton Google.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Contenu principal : defilable si l'ecran est petit ou la police
         agrandie. Le bouton Google reste le premier appel a l'action. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:contentDescription="@string/auth_title"
                android:src="@drawable/vitrine_logo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/auth_title"
                android:textColor="#022358"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/auth_subtitle"
                android:textColor="#23467F"
                android:textSize="16sp" />

            <!-- Barre de progression : visible uniquement pendant la connexion. -->
            <ProgressBar
                android:id="@+id/auth_progress"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:indeterminate="true"
                android:indeterminateTint="#F95C0F"
                android:visibility="gone" />

            <TextView
                android:id="@+id/auth_preparing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/auth_preparing"
                android:textColor="#022358"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/auth_preparing_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/auth_preparing_sub"
                android:textColor="#5A6B8C"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/auth_google_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:backgroundTint="#F95C0F"
                android:minHeight="52dp"
                android:text="@string/auth_google"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- Une seule phrase de reassurance, pas un discours. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/auth_new_here"
                android:textColor="#5A6B8C"
                android:textSize="13sp" />

            <!-- Message d'erreur : actionnable, jamais technique. -->
            <TextView
                android:id="@+id/auth_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!--
      Bloc bas ANCRE (D42.26) : le mode sans compte est conserve (le coeur
      creatif fonctionne reellement hors ligne) mais DECLARE comme tel, sans
      laisser croire que le compte et les credits sont disponibles.
      Nielsen #2 : correspondance avec le monde reel. Ce bloc ne depend plus
      du defilement : il est TOUJOURS visible, quel que soit l'ecran.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/auth_offline_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/auth_offline"
            android:textAllCaps="false"
            android:textColor="#23467F"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/auth_offline_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/auth_offline_body"
            android:textColor="#7A88A3"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
