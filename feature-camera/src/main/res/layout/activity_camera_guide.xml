<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/camera_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- D42.16 (défaut A4, runs 42278038365/42281822052) : le bouton était le
         DERNIER élément de la barre et se retrouvait ROGNÉ à 40 px au bas de la
         fenêtre (le texte de guide, localisé en 4 langues, le repoussait hors
         écran). L'action critique passe EN PREMIER, avec une hauteur explicite :
         aucune langue ni taille de police ne peut plus la faire sortir. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- D42.27 (5.4) : bascule avant/arrière. Placé AU-DESSUS de l'action
             critique : camera_record_button (56 dp) reste en position sûre,
             le bouton de bascule (48 dp) est le premier enfant donc jamais
             rogné non plus (cf. A4 : seul le DERNIER élément était rognable). -->
        <Button
            android:id="@+id/camera_flip_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/camera_flip" />

        <Button
            android:id="@+id/camera_record_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/camera_record" />

        <TextView
            android:id="@+id/camera_guide_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:background="#CC000000"
            android:padding="8dp"
            android:text="@string/camera_guide"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
