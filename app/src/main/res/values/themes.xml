<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme officiel : palette du logo (orange store, bleu nuit, blanc pur). -->
    <style name="Theme.VitrineVideo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorPrimary">#FF5500</item>
        <item name="android:colorPrimaryDark">#0A192F</item>
        <item name="android:colorAccent">#FF5500</item>
    </style>
    <!-- D42.33 (spec §9.1) : temps de marque — fond navy, insigne dans une
         tuile blanche rayon 26. Le splash disparaît au premier rendu (durée
         système ≤ 1,2 s ; barre de chargement non rendue par l'API splash
         12+ — écart documenté, l'écran d'émotion suivant porte la marque). -->
    <style name="Theme.VitrineVideo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#022358</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_tuile</item>
        <item name="postSplashScreenTheme">@style/Theme.VitrineVideo</item>
    </style>
</resources>
