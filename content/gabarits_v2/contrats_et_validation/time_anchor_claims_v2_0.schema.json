{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contenu du JWS d’ancre temporelle ES256 – V2.0",
  "description": "Le défi doit être unique et lié à la preuve de possession et au lot existant.",
  "type": "object",
  "required": [
    "iss",
    "aud",
    "sub",
    "jti",
    "iat",
    "nbf",
    "exp",
    "purpose",
    "grant_id",
    "installation_id",
    "cnf",
    "server_time_ms",
    "challenge_sha256"
  ],
  "properties": {
    "iss": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "aud": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "jti": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "nbf": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "purpose": {
      "const": "TIME_ANCHOR"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "cnf": {
      "type": "object",
      "required": [
        "spki_sha256"
      ],
      "properties": {
        "spki_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "server_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "challenge_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
