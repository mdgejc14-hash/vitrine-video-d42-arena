{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retraits connus liés au manifeste – V1.3",
  "description": "Le SHA-256 du fichier est couvert par le manifeste Ed25519. Hors ligne les retraits futurs restent inconnus.",
  "type": "object",
  "required": [
    "schema_version",
    "sequence_release",
    "updated_at_utc",
    "pistes_retirees",
    "sfx_retires"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "sequence_release": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "pistes_retirees": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "piste_id",
          "asset_sha256",
          "raison_code",
          "connu_le_utc"
        ],
        "properties": {
          "piste_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raison_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "connu_le_utc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "sfx_retires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "categorie_json",
          "asset_sha256",
          "raison_code",
          "connu_le_utc"
        ],
        "properties": {
          "categorie_json": {
            "enum": [
              "whoosh_soft",
              "whoosh_fast",
              "caisse_enregistreuse",
              "clic_appareil",
              "impact_drop",
              "pop_badge",
              "amb_chantier",
              "sizzle_grill",
              "vapeur_plat"
            ]
          },
          "asset_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "raison_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "connu_le_utc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
