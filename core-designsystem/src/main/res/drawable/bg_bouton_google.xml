<?xml version="1.0" encoding="utf-8"?>
<!-- D42.33 (§6/§8-B) : pilule blanche filet Line pour le bouton Google.
     États : désactivé #EDEFF5 (sans ombre), pressé léger voile orange. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#EDEFF5" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF1E8" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#E2E8F0" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
