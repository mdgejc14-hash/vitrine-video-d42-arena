<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <!-- D42.33 : titres Jakarta, corps Inter (polices locales fusionnées). -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans_extrabold"
            android:text="@string/export_progress_title"
            android:textColor="#022358"
            android:textSize="21sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:text="@string/export_progress_sub"
            android:textColor="#23467F"
            android:textSize="14.5sp" />

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/export_preview_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/export_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:text="— %"
                android:textColor="#022358"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/export_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/export_card_preparing"
                android:textColor="#23467F"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/export_progress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progressTint="#F95C0F"
                android:progressBackgroundTint="#EDEFF5"
                style="?android:attr/progressBarStyleHorizontal" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_card_step_title"
                android:textColor="#022358"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/export_card_step_body"
                android:textColor="#23467F"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_card_time_title"
                android:textColor="#022358"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/export_card_time_body"
                android:textColor="#23467F"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/export_share"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#F95C0F"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/export_share"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/export_space"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:fontFamily="@font/inter_semibold"
            android:text="@string/export_space"
            android:textColor="#D34905"
            android:textSize="14.5sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/export_start"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#F95C0F"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:text="@string/export_start"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
